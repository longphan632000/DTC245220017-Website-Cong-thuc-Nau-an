{
  "uid": "de29-logs",
  "title": "Đề 29 - Log tập trung",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Log ứng dụng Recipe",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"d29-recipe-app\"}",
          "queryType": "range",
          "maxLines": 30
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "Log MySQL",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"d29-mysql\"}",
          "queryType": "range",
          "maxLines": 30
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "title": "Nginx request không tìm thấy",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"d29-nginx\"} |= \"404\"",
          "queryType": "range",
          "maxLines": 30
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "id": null,
  "version": 1,
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Chọn datasource Loki đã tạo trong Grafana",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ]
}
